generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  AWOL
  BLACKLISTED
  FLOATING
  LEAVE
  NOSCHEDULE
  RESIGNED
  TERMINATE
  INACTIVE
  ENDED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PREVIEWED
  RELEASED
  VOIDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  PAID
  PARTIAL
  CANCELLED
}

enum AttendanceSource {
  REMOTE_CLOCK
  ADMIN_MANUAL
  IMPORT
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model UserAccount {
  id                   Int           @id @default(autoincrement())
  employeeId           Int?
  employeeCode         String?
  storeId              Int?
  storeCode            String?
  username             String        @unique
  passwordHash         String
  legacyPassword       String?
  role                 UserRole      @default(EMPLOYEE)
  menuRole             String?
  status               AccountStatus @default(ACTIVE)
  mustChangePassword   Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  employee             Employee?     @relation(fields: [employeeId], references: [id])
  store                Store?        @relation(fields: [storeId], references: [id])
  refreshSessions      RefreshSession[]
  auditLogs            AuditLog[]    @relation("AuditActor")

  @@index([employeeId])
  @@index([storeId])
  @@index([role])
  @@index([status])
}

model RefreshSession {
  id                   Int          @id @default(autoincrement())
  userId               Int
  tokenHash            String
  userAgent            String?
  ipAddress            String?
  expiresAt            DateTime
  revokedAt            DateTime?
  createdAt            DateTime     @default(now())

  user                 UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Store {
  id                   Int           @id @default(autoincrement())
  code                 String        @unique
  name                 String
  address              String?
  area                 String?
  contactNumber        String?
  contactPerson        String?
  contactPersonNumber  String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  users                UserAccount[]
  employees            Employee[]

  @@index([name])
}

model Employee {
  id                   Int                  @id @default(autoincrement())
  storeId              Int?
  employeeCode         String
  firstName            String
  middleName           String?
  lastName             String
  birthdate            DateTime?
  age                  Int?
  gender               String?
  religion             String?
  address              String?
  phone                String?
  email                String?
  sssId                String?
  sssContribution      Decimal              @default(0) @db.Decimal(12, 2)
  philhealthId         String?
  philhealthContribution Decimal            @default(0) @db.Decimal(12, 2)
  pagibigId            String?
  pagibigContribution  Decimal              @default(0) @db.Decimal(12, 2)
  hireDate             DateTime?
  endDate              DateTime?
  position             String?
  salary               Decimal              @default(0) @db.Decimal(12, 2)
  funds                Decimal              @default(0) @db.Decimal(12, 2)
  emergencyContactName String?
  emergencyContactNumber String?
  status               EmployeeStatus       @default(ACTIVE)
  hasAssets            Boolean              @default(false)
  assetRemarks         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  store                Store?               @relation(fields: [storeId], references: [id])
  payrolls             Payroll[]
  userAccounts         UserAccount[]
  timeRecords          TimeRecord[]
  workSchedules        EmployeeWorkSchedule[]
  images               EmployeeImage?
  cashAdvances         CashAdvance[]
  leaves               EmployeeLeave[]
  leaveBalances        EmployeeLeaveBalance[]
  groups               EmployeeGroupMember[]
  fundsLogs            FundsLog[]
  allowances           Allowance[]

  @@unique([employeeCode])
  @@index([storeId])
  @@index([status])
  @@index([lastName, firstName])
}

model EmployeeGroup {
  id                   Int                   @id @default(autoincrement())
  name                 String                @unique
  members              EmployeeGroupMember[]
}

model EmployeeGroupMember {
  employeeId           Int
  groupId              Int
  role                 String?

  employee             Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  group                EmployeeGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([employeeId, groupId])
}

model Payroll {
  id                   Int              @id @default(autoincrement())
  employeeId           Int
  daysOfWork           Decimal          @default(0) @db.Decimal(10, 2)
  rate                 Decimal          @default(0) @db.Decimal(12, 2)
  totalRegularWage     Decimal          @default(0) @db.Decimal(12, 2)
  overtimeHours        Decimal          @default(0) @db.Decimal(10, 2)
  lateHours            Decimal          @default(0) @db.Decimal(10, 2)
  overtimeAmount       Decimal          @default(0) @db.Decimal(12, 2)
  lateAmount           Decimal          @default(0) @db.Decimal(12, 2)
  allowance            Decimal          @default(0) @db.Decimal(12, 2)
  totalAllowance       Decimal          @default(0) @db.Decimal(12, 2)
  addOnHoliday         Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal          @default(0) @db.Decimal(12, 2)
  sssDeduction         Decimal          @default(0) @db.Decimal(12, 2)
  philhealthDeduction  Decimal          @default(0) @db.Decimal(12, 2)
  pagibigDeduction     Decimal          @default(0) @db.Decimal(12, 2)
  valeDeduction        Decimal          @default(0) @db.Decimal(12, 2)
  charge               Decimal          @default(0) @db.Decimal(12, 2)
  credit               Decimal          @default(0) @db.Decimal(12, 2)
  loanDeduction        Decimal          @default(0) @db.Decimal(12, 2)
  penaltyOrUndertime   Decimal          @default(0) @db.Decimal(12, 2)
  pondo                Decimal          @default(0) @db.Decimal(12, 2)
  sssLoan              Decimal          @default(0) @db.Decimal(12, 2)
  pagibigLoan          Decimal          @default(0) @db.Decimal(12, 2)
  philhealthLoan       Decimal          @default(0) @db.Decimal(12, 2)
  endingFund           Decimal          @default(0) @db.Decimal(12, 2)
  netAmountPaid        Decimal          @default(0) @db.Decimal(12, 2)
  payrollDate          DateTime         @default(now())
  payrollFrom          DateTime?
  payrollTo            DateTime?
  penaltyRate          Decimal          @default(0) @db.Decimal(12, 2)
  penaltyRemarks       String?
  bonusRate            Decimal          @default(0) @db.Decimal(12, 2)
  bonusRemarks         String?
  otherDeduction       Decimal          @default(0) @db.Decimal(12, 2)
  payMethod            String?
  createdBy            String?
  status               PayrollStatus    @default(DRAFT)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  employee             Employee         @relation(fields: [employeeId], references: [id])
  selectedPayments     SelectedPayment[]
  disputes             Dispute[]

  @@index([employeeId])
  @@index([payrollFrom, payrollTo])
  @@index([status])
}

model SelectedPayment {
  id                   Int       @id @default(autoincrement())
  payrollId            Int
  type                 String
  date                 DateTime  @default(now())
  amount               Decimal   @default(0) @db.Decimal(12, 2)
  cashAdvanceId        Int?
  installmentPlan      Int       @default(1)

  payroll              Payroll   @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
}

model Dispute {
  id                   Int       @id @default(autoincrement())
  payrollId            Int
  timeRecordId         Int
  employeeId           Int
  status               String
  scheduleDate         String
  date                 DateTime  @default(now())

  payroll              Payroll   @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@index([employeeId])
}

model TimeRecord {
  id                   Int              @id @default(autoincrement())
  employeeId           Int
  timeIn               DateTime?
  timeOut              DateTime?
  locationIn           String?
  locationOut          String?
  timeInImage          String?
  timeOutImage         String?
  encoder              String?
  source               AttendanceSource @default(REMOTE_CLOCK)
  manualReason         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  employee             Employee         @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([timeIn])
  @@index([timeOut])
}

model WorkSchedule {
  id                   Int                    @id @default(autoincrement())
  shiftName            String
  workDay              String
  startTime            DateTime
  endTime              DateTime
  breakStart           DateTime?
  breakEnd             DateTime?
  duration             Decimal?               @db.Decimal(10, 2)
  breakDuration        Decimal?               @db.Decimal(10, 2)
  status               String
  notes                String?
  recurrenceType       RecurrenceType          @default(NONE)
  recurrenceEnd        DateTime?
  recurrenceDays       String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  employees            EmployeeWorkSchedule[]
}

model ScheduleTemplate {
  id                   Int                    @id @default(autoincrement())
  name                 String
  description          String?
  workDay              String?
  startTime            DateTime
  endTime              DateTime
  breakStart           DateTime?
  breakEnd             DateTime?
  duration             Decimal?               @db.Decimal(10, 2)
  breakDuration        Decimal?               @db.Decimal(10, 2)
  legacyEmployeeIds    String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  employees            EmployeeWorkSchedule[]
}

model EmployeeWorkSchedule {
  employeeId           Int
  scheduleId           Int
  templateId           Int?

  employee             Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workSchedule         WorkSchedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleTemplate     ScheduleTemplate? @relation(fields: [templateId], references: [id])

  @@id([employeeId, scheduleId])
}

model EmployeeImage {
  id                   Int       @id @default(autoincrement())
  employeeId           Int       @unique
  validId1             String?
  validId2             String?
  mugshot1             String?
  mugshot2             String?
  mugshot3             String?
  mugshot4             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model CashAdvance {
  id                   Int                  @id @default(autoincrement())
  referenceNumber      String?
  atd                  String?
  employeeId           Int
  employeeCode         String?
  amount               Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal              @default(0) @db.Decimal(12, 2)
  reason               String?
  paymentMethod        String?
  encoder              String?
  type                 String?
  dateIssued           DateTime             @default(now())
  repaymentDue         DateTime?
  installmentPlan      Int                  @default(1)
  totalPaid            Decimal              @default(0) @db.Decimal(12, 2)
  balance              Decimal              @default(0) @db.Decimal(12, 2)
  interests            Decimal              @default(0) @db.Decimal(12, 2)
  status               PaymentStatus        @default(PENDING)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  employee             Employee             @relation(fields: [employeeId], references: [id])
  payments             CashAdvancePayment[]

  @@index([employeeId])
  @@index([status])
}

model CashAdvancePayment {
  id                   Int          @id @default(autoincrement())
  cashAdvanceId        Int
  paymentDate          DateTime     @default(now())
  amountPaid           Decimal      @db.Decimal(12, 2)
  paymentMethod        String?
  type                 String?
  status               PaymentStatus @default(PAID)
  createdAt            DateTime     @default(now())

  cashAdvance          CashAdvance  @relation(fields: [cashAdvanceId], references: [id], onDelete: Cascade)

  @@index([cashAdvanceId])
}

model EmployeeLeave {
  id                   Int          @id @default(autoincrement())
  employeeId           Int
  leaveType            String
  startDate            DateTime
  endDate              DateTime
  duration             Int
  status               LeaveStatus  @default(PENDING)
  reason               String?
  leaveRate            Decimal      @default(0) @db.Decimal(12, 2)
  approvedBy           String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  employee             Employee     @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
}

model EmployeeLeaveBalance {
  id                   Int       @id @default(autoincrement())
  employeeId           Int
  leaveType            String
  totalLeaves          Int       @default(0)
  usedLeaves           Int       @default(0)
  remainingLeaves      Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveType])
}

model Allowance {
  id                   Int       @id @default(autoincrement())
  atd                  String?
  employeeId           Int
  type                 String
  amount               Decimal   @default(0) @db.Decimal(12, 2)
  encoder              String
  status               String?
  remarks              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  employee             Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model FundsLog {
  id                   Int       @id @default(autoincrement())
  atd                  String?
  employeeId           Int
  action               String
  type                 String
  amount               Decimal   @default(0) @db.Decimal(12, 2)
  funds                Decimal   @default(0) @db.Decimal(12, 2)
  encoder              String
  cashBy               String?
  paymentMethod        String?
  status               String?
  remarks              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  employee             Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model Reminder {
  id                   Int            @id @default(autoincrement())
  title                String
  description          String?
  frequency            String         @default("DAILY")
  dayOfWeek            String?
  timeOfDay            String?
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tasks                ReminderTask[]
}

model ReminderTask {
  id                   Int       @id @default(autoincrement())
  reminderId           Int
  name                 String
  sortOrder            Int       @default(0)

  reminder             Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
}

model StoredFile {
  id                   Int       @id @default(autoincrement())
  module               String
  ownerType            String?
  ownerId              Int?
  originalName         String
  storedName           String
  relativePath         String
  mimeType             String
  sizeBytes            BigInt
  checksum             String?
  uploadedById         Int?
  createdAt            DateTime  @default(now())

  @@index([module])
  @@index([ownerType, ownerId])
}

model AuditLog {
  id                   Int          @id @default(autoincrement())
  actorId              Int?
  action               String
  entityType           String
  entityId             String?
  metadata             Json?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime     @default(now())

  actor                UserAccount? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
